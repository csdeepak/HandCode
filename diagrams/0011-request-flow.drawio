                <mxCell id="p4_title" value="Crash &amp; Resume" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#171C26;" vertex="1" parent="1">
                    <mxGeometry x="60" y="30" width="600" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sub" value="Where the ledger earns its existence. Without it, run 2 produces a second commit — confirmed upstream behaviour, not a hypothetical." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#737F92;" vertex="1" parent="1">
                    <mxGeometry x="60" y="62" width="1100" height="20" as="geometry"/>
                </mxCell>
                <!-- RUN 1 -->
                <mxCell id="p4_r1box" value="RUN 1 — crashes mid-tool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#B02A2A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#4A1212;" vertex="1" parent="1">
                    <mxGeometry x="60" y="120" width="700" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="p4_a1" value="ActionEvent appended&#xa;id = tc_7 · tool = git commit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F7A4A;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="100" y="165" width="290" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p4_a2" value="ledger: write INTENT tc_7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4432C;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="100" y="245" width="290" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p4_a3" value="git commit  →  abc123 lands in the world" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#15803D;strokeWidth=2;fontSize=12;fontColor=#0F3D20;" vertex="1" parent="1">
                    <mxGeometry x="100" y="317" width="290" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p4_kill" value="kill -9&#xa;before COMMITTED is written" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B02A2A;strokeColor=#B02A2A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="100" y="397" width="290" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p4_state1" value="STATE LEFT BEHIND&#xa;&#xa;EventLog:   ActionEvent tc_7, no ObservationEvent&#xa;Ledger:      tc_7 = INTENT&#xa;World:        commit abc123 EXISTS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B02A2A;dashed=1;align=left;spacingLeft=12;verticalAlign=middle;fontSize=11;fontFamily=Courier New;fontColor=#4A1212;" vertex="1" parent="1">
                    <mxGeometry x="430" y="245" width="300" height="130" as="geometry"/>
                </mxCell>
                <!-- RUN 2 -->
                <mxCell id="p4_r2box" value="RUN 2 — resume" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEFFC;strokeColor=#2F5FE0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#152A5E;" vertex="1" parent="1">
                    <mxGeometry x="840" y="120" width="740" height="600" as="geometry"/>
                </mxCell>
                <mxCell id="p4_b1" value="load base_state.json + events/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F7A4A;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="880" y="165" width="300" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p4_b2" value="get_unmatched_actions() → [tc_7]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF1E0;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#4A3210;" vertex="1" parent="1">
                    <mxGeometry x="880" y="235" width="300" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p4_warn" value="Without the gate, the harness&#xa;re-executes here — second commit." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#B02A2A;dashed=1;fontSize=11;fontStyle=2;fontColor=#4A1212;" vertex="1" parent="1">
                    <mxGeometry x="1220" y="235" width="320" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p4_b3" value="ledger.lookup(tc_7)  →  INTENT · ambiguous" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4432C;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="880" y="305" width="300" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p4_b4" value="class = NON_IDEMPOTENT_WRITE&#xa;→ never re-execute on INTENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF1E0;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#4A3210;" vertex="1" parent="1">
                    <mxGeometry x="880" y="375" width="300" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p4_b5" value="reconciliation probe&#xa;git log --grep=intent_hash" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="880" y="453" width="300" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p4_b6" value="found abc123  →  reconcile tc_7 to COMMITTED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#15803D;strokeWidth=2;fontSize=12;fontColor=#0F3D20;" vertex="1" parent="1">
                    <mxGeometry x="880" y="531" width="300" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p4_b7" value="synthesize observation → agent continues&#xa;NO SECOND COMMIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#15803D;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#0F3D20;" vertex="1" parent="1">
                    <mxGeometry x="880" y="609" width="300" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#171C26;" edge="1" parent="1" source="p4_a1" target="p4_a2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#171C26;" edge="1" parent="1" source="p4_a2" target="p4_a3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B02A2A;strokeWidth=2;" edge="1" parent="1" source="p4_a3" target="p4_kill">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e4" value="resume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2F5FE0;strokeWidth=2;dashed=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4_kill" target="p4_b1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="245" y="500"/>
                            <mxPoint x="800" y="500"/>
                            <mxPoint x="800" y="187"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p4_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#171C26;" edge="1" parent="1" source="p4_b1" target="p4_b2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#171C26;" edge="1" parent="1" source="p4_b2" target="p4_b3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#171C26;" edge="1" parent="1" source="p4_b3" target="p4_b4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#171C26;" edge="1" parent="1" source="p4_b4" target="p4_b5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#171C26;" edge="1" parent="1" source="p4_b5" target="p4_b6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#15803D;strokeWidth=2;" edge="1" parent="1" source="p4_b6" target="p4_b7">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_note" value="THE HONEST GUARANTEE&#xa;&#xa;This does not claim exactly-once. The window between writing INTENT and writing COMMITTED cannot be closed —&#xa;the ledger and the world are two stores with no atomic commit between them.&#xa;&#xa;What it claims instead: an unbounded double-execution risk spanning every crash becomes a bounded one spanning&#xa;a single tool call, with class-based and probe-based mitigation inside that window." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEFFC;strokeColor=#2F5FE0;align=left;spacingLeft=16;verticalAlign=middle;fontSize=11;fontColor=#152A5E;" vertex="1" parent="1">
                    <mxGeometry x="60" y="600" width="700" height="150" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="failover" name="5 · Failover Hazard">
        <mxGraphModel dx="1400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p5_title" value="Failover, and the Mid-Turn Hazard" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#171C26;" vertex="1" parent="1">
                    <mxGeometry x="60" y="30" width="700" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p5_sub" value="Switching between turns is cheap and already handled by the data plane. Switching inside one can defeat the effect ledger&#39;s primary key." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#737F92;" vertex="1" parent="1">
                    <mxGeometry x="60" y="62" width="1100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p5_safe" value="SAFE — failover between turns" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#15803D;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#0F3D20;" vertex="1" parent="1">
                    <mxGeometry x="60" y="120" width="740" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="p5_1" value="turn N request  →  affinity pins acct A (warm cache)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="100" y="170" width="330" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="p5_2" value="acct A  →  429 rate limited" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF1E0;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#4A3210;" vertex="1" parent="1">
                    <mxGeometry x="100" y="244" width="330" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="p5_3" value="router: cooldown acct A · fallback to acct B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7689;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="100" y="318" width="330" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="p5_4" value="acct B  →  200, but CACHE MISS&#xa;full prefill · latency up · cost up" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="100" y="392" width="330" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p5_5" value="cost ledger records the switch cost&#xa;affinity repoints to acct B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEFFC;strokeColor=#2F5FE0;fontSize=12;fontColor=#152A5E;" vertex="1" parent="1">
                    <mxGeometry x="470" y="392" width="300" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p5_safen" value="Chat completions are stateless, so the whole history is resent.&#xa;The only real cost of the switch is the discarded warm cache —&#xa;measured at 41–80% of input cost and 13–31% of time-to-first-token." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#0F3D20;" vertex="1" parent="1">
                    <mxGeometry x="470" y="180" width="310" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5_haz" value="HAZARD — failover inside a turn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#B02A2A;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#4A1212;" vertex="1" parent="1">
                    <mxGeometry x="860" y="120" width="720" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="p5_h1" value="turn N left unresolved tool_calls&#xa;the next message MUST carry matching results" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B02A2A;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="900" y="170" width="640" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p5_h2" value="endpoint changes mid-turn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF1E0;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#4A3210;" vertex="1" parent="1">
                    <mxGeometry x="900" y="250" width="640" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="p5_h3" value="model families mint tool_call_id differently&#xa;→ the id may be rejected, or simply not match" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B02A2A;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="900" y="320" width="640" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p5_h4" value="THE LEDGER IS KEYED ON tool_call_id&#xa;a committed effect becomes invisible — and is re-executed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B02A2A;strokeColor=#B02A2A;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="900" y="400" width="640" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p5_h5" value="Failover would defeat the very guard built to prevent double execution." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#B02A2A;" vertex="1" parent="1">
                    <mxGeometry x="900" y="465" width="640" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p5_rule" value="THE RULE — the turn is the atomic unit of routing&#xa;&#xa;An endpoint may change between turns and never within one. A turn with unresolved tool calls must complete against the&#xa;endpoint that opened it, or be abandoned and replanned as a whole.&#xa;&#xa;Cheap to enforce at Seam A: the request hook already knows whether the outgoing message list ends in unresolved tool calls." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEEEA;strokeColor=#B4432C;strokeWidth=3;align=left;spacingLeft=18;verticalAlign=middle;fontSize=12;fontColor=#3D1A10;" vertex="1" parent="1">
                    <mxGeometry x="60" y="600" width="1520" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p5_q" value="Open question Q10 — is tool_call_id stable across providers, not just across resume? A strict superset of Q2. Unresolved." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#737F92;" vertex="1" parent="1">
                    <mxGeometry x="60" y="755" width="1000" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#171C26;" edge="1" parent="1" source="p5_1" target="p5_2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#171C26;" edge="1" parent="1" source="p5_2" target="p5_3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#171C26;" edge="1" parent="1" source="p5_3" target="p5_4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2F5FE0;dashed=1;" edge="1" parent="1" source="p5_4" target="p5_5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B02A2A;strokeWidth=2;" edge="1" parent="1" source="p5_h1" target="p5_h2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B02A2A;strokeWidth=2;" edge="1" parent="1" source="p5_h2" target="p5_h3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B02A2A;strokeWidth=3;" edge="1" parent="1" source="p5_h3" target="p5_h4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
