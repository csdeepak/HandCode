                <mxCell id="p3_sub1" value="Return stored observation&#xa;DO NOT EXECUTE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#15803D;strokeWidth=2;fontSize=12;fontColor=#0F3D20;" vertex="1" parent="1">
                    <mxGeometry x="1180" y="310" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p3_amb" value="AMBIGUOUS&#xa;did the effect land?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDF1E0;strokeColor=#B45309;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#4A3210;" vertex="1" parent="1">
                    <mxGeometry x="600" y="450" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p3_ambn" value="Cannot be eliminated. The ledger and the world are two stores with no atomic commit between them." style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#B45309;" vertex="1" parent="1">
                    <mxGeometry x="560" y="565" width="360" height="30" as="geometry"/>
