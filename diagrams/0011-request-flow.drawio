                </mxCell>
                <mxCell id="p3_sub" value="Five ledger states, five effect classes, one irreducible ambiguity. Three of the five classes escape the hard path cheaply — classification, not cleverness, is what makes this tractable." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#737F92;" vertex="1" parent="1">
                    <mxGeometry x="60" y="62" width="1100" height="20" as="geometry"/>
