                <mxCell id="p2_s3" value="3 · Condenser builds the model-visible view — harness-owned, SKIP verdict in doc 0007" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF4EE;strokeColor=#3F7A4A;dashed=1;align=left;spacingLeft=14;fontSize=12;fontColor=#1D3A23;" vertex="1" parent="1">
                    <mxGeometry x="60" y="252" width="820" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="p2_bandA" value="SEAM A — Request Hook · in-band" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEEEA;strokeColor=#B4432C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#3D1A10;" vertex="1" parent="1">
                    <mxGeometry x="40" y="320" width="860" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="p2_s4" value="4 · Read compiled policy from local file — no network call to the control plane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4432C;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="60" y="352" width="820" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p2_s5" value="5 · Turn-atomic check — does the message list end in unresolved tool_calls?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4432C;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="60" y="398" width="820" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p2_s6" value="6 · Cache affinity — prefix hash → deployment · model tier for task class" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4432C;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="60" y="444" width="820" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p2_s7" value="7 · Stamp trace_id = (conversation_id, turn_id) — the join that makes spend attributable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4432C;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="60" y="490" width="820" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p2_s8" value="8 · LiteLLM Router → Provider → assistant message + tool_calls (usage carries cache read / creation tokens)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F3F8;strokeColor=#6B7689;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="60" y="576" width="820" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="p2_s9" value="9 · ActionEvent persisted to the EventLog — BEFORE the tool runs&#xa;Deliberate upstream ordering. This is what makes confirmation mode possible, and what makes double execution possible." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF1E0;strokeColor=#B45309;strokeWidth=2;align=left;spacingLeft=14;fontSize=12;fontColor=#4A3210;" vertex="1" parent="1">
                    <mxGeometry x="60" y="642" width="820" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="p2_bandC" value="SEAM C — Effect Gate · the only enforcement point" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEEEA;strokeColor=#B4432C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#3D1A10;" vertex="1" parent="1">
                    <mxGeometry x="40" y="722" width="860" height="232" as="geometry"/>
                </mxCell>
                <mxCell id="p2_s10" value="10 · Classify tool → effect_class (from the Capability Matrix)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4432C;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="60" y="754" width="820" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p2_s11" value="11 · ledger.lookup(tool_call_id) — see page 3 for the full decision" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4432C;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="60" y="800" width="820" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p2_s12" value="12 · write INTENT + fsync   →   EXECUTE TOOL   →   write COMMITTED + observation + fsync" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#B02A2A;strokeWidth=2;align=left;spacingLeft=14;fontSize=12;fontStyle=1;fontColor=#4A1212;" vertex="1" parent="1">
                    <mxGeometry x="60" y="846" width="820" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p2_s12n" value="The gap between these two writes is the only place a duplicate effect can be born." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#B02A2A;" vertex="1" parent="1">
                    <mxGeometry x="60" y="896" width="820" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p2_s13" value="13 · ObservationEvent appended → Seam B observes and attributes the turn&#39;s cost" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF4EE;strokeColor=#3F7A4A;align=left;spacingLeft=14;fontSize=12;fontColor=#1D3A23;" vertex="1" parent="1">
