# Secrets — never commit
.env
.env.*
*.key
*.pem
secrets/
config/local/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Working artifacts
scratch/
*.log

# Experiment run artifacts -- regenerated by verify.py, not source
experiments/*/results/*.json

# build artifacts, regenerated by pip install / pip wheel
*.egg-info/
/build/
/dist/

# Runtime state written into a workspace -- never source
.agentctl/
*.db
*.db-wal
*.db-shm

# Scratch workspaces created by `agentctl run --workspace ./...` inside the
# repo. They hold your code and a ledger, not this project source.
/myproject/
/demo/
/scratch-*/

# Provider API keys. Written by `agentctl keys --init`.
keys.env
*.env
!*.env.template

# Generated proxy config (agentctl proxy). Regenerate, do not commit.
/proxy/

# Agent worktrees are transient checkouts, never content.
.claude/worktrees/

# Seam A telemetry. Runtime output of a proxy, never source: a hand-run proxy
# writes it into its working directory, and the copy at the repo root was
# noise in every commit from 0042 on (docs/0051 Stage 0).
hook_telemetry.json

# The documentation site, built by website/build.py
_site/
