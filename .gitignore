# Secrets — never commit
.env
.env.*
*.key
*.pem
secrets/
config/local/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Working artifacts
scratch/
*.log

# Experiment run artifacts -- regenerated by verify.py, not source
experiments/*/results/*.json

# build artifact, regenerated by pip install -e
*.egg-info/

# Runtime state written into a workspace -- never source
.agentctl/
*.db
*.db-wal
*.db-shm

# Scratch workspaces created by `agentctl run --workspace ./...` inside the
# repo. They hold your code and a ledger, not this project source.
/myproject/
/demo/
/scratch-*/
